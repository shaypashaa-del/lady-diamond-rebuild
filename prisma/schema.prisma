// Lady Diamond Jewels — rebuild schema (Phase 1)
// learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth / Users ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  STORE_MANAGER
  AFFILIATE
  CUSTOMER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role     @default(CUSTOMER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  affiliate     Affiliate?
  notes         CustomerNote[]       @relation("CustomerNoteSubject")
  authoredNotes CustomerNote[]       @relation("CustomerNoteAuthor")
  resetTokens   PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  country   String
  city      String
  street    String
  apartment String?
  zip       String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("CustomerNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Catalog ----------

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Translatable text fields are stored as JSON objects, e.g. { "he": "...", "en": "...", "ru": "..." }.
// Hebrew ("he") is the required/default key; "en" and "ru" may be partial and fall back to "he"
// at render time (see src/lib/i18n-content.ts).

model Category {
  id             String            @id @default(cuid())
  name           Json
  slug           String            @unique
  description    Json?
  imageId        String?
  image          MediaAsset?       @relation(fields: [imageId], references: [id])
  parentId       String?
  parent         Category?         @relation("CategoryToParent", fields: [parentId], references: [id])
  children       Category[]        @relation("CategoryToParent")
  sortOrder      Int               @default(0)
  seoTitle       Json?
  seoDescription Json?
  products       ProductCategory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([parentId])
}

model Tag {
  id       String       @id @default(cuid())
  name     Json
  slug     String       @unique
  products ProductTag[]
}

model Product {
  id               String        @id @default(cuid())
  name             Json
  slug             String        @unique
  description      Json?
  shortDescription Json?
  basePrice        Decimal       @db.Decimal(10, 2)
  salePrice        Decimal?      @db.Decimal(10, 2)
  sku              String?       @unique
  inventory        Int           @default(0)
  trackInventory   Boolean       @default(true)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  seoTitle         Json?
  seoDescription   Json?
  weightGrams      Int?

  // ---- Configurable pricing engine (opt-in, additive) ----
  // pricingMode stays FLAT (the historical behavior: basePrice/salePrice
  // shown as-is) for every product unless an admin explicitly switches it
  // to CONFIGURABLE after entering real metalWeightGrams and at least one
  // ProductMaterialOption. Nothing here changes existing product behavior
  // until that opt-in happens. See src/lib/pricing/engine.ts.
  pricingMode       PricingMode @default(FLAT)
  metalWeightGrams  Decimal?    @db.Decimal(8, 3)
  manufacturingCost Decimal?    @db.Decimal(10, 2)
  settingCost       Decimal?    @db.Decimal(10, 2)
  otherCost         Decimal?    @db.Decimal(10, 2)
  hasDiamond        Boolean     @default(false)

  materialOptions        ProductMaterialOption[]
  diamondOptions         ProductDiamondOption[]
  priceDropSubscriptions PriceDropSubscription[]

  categories  ProductCategory[]
  tags        ProductTag[]
  images      ProductImage[]
  variants    ProductVariant[]
  relatedTo   ProductRelation[] @relation("RelatedFrom")
  relatedFrom ProductRelation[] @relation("RelatedTo")
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isFeatured])
}

enum PricingMode {
  FLAT
  CONFIGURABLE
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
}

// Fineness/purity, one enum shared across metal types since each value is
// unambiguous on its own (K14 only ever means gold, S925 only ever means
// silver) — avoids needing a separate enum + cross-validation per metal.
enum MetalPurity {
  K9
  K14
  K18
  K22
  K24
  S925
  S999
  PT950
}

enum GoldColor {
  YELLOW
  WHITE
  ROSE
}

// A specific material a customer can choose for this product (e.g. "14K
// White Gold" or "Sterling Silver 925"). Which combinations are offered is
// entirely admin-defined per product — see AGENTS.md step 2/14: never show
// a metal/purity that isn't actually manufacturable for that design.
model ProductMaterialOption {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  metalType MetalType
  purity    MetalPurity
  goldColor GoldColor?
  isDefault Boolean     @default(false)
  sortOrder Int         @default(0)
  active    Boolean     @default(true)

  // Optional per-color product photo — most products only have one photo
  // (the actual manufactured color), so this stays null and the product's
  // default gallery image is shown regardless of color selected. Only set
  // when a real photo of that specific color exists (never an AI mockup
  // presented as a photo without the "made to order" disclaimer already
  // shown next to the color swatches).
  imageUrl String?

  @@index([productId])
}

// FANCY_COLOR added alongside the original NATURAL/LAB_GROWN per the
// owner's 3-category diamond-origin spec (Lab Grown / Natural / Natural
// Fancy Color) — a fancy-color diamond is still a natural stone, but its
// pricing and attribute set (fancyColor/fancyIntensity, no plain D-M color
// grade) are different enough to warrant its own type rather than a flag.
enum DiamondType {
  NATURAL
  LAB_GROWN
  FANCY_COLOR
}

// How a lab-grown diamond was actually grown — customer-facing detail the
// owner's spec calls for whenever diamondType = LAB_GROWN.
enum DiamondGrowthMethod {
  CVD
  HPHT
}

enum DiamondShape {
  ROUND
  OVAL
  EMERALD
  PRINCESS
  PEAR
  MARQUISE
  CUSHION
  RADIANT
  ASSCHER
  HEART
}

// K/L/M added to the original D-J range per the owner's spec — a fuller
// commercial-grade color scale for plain white diamonds only. Not used for
// DiamondType.FANCY_COLOR, which uses fancyColor/fancyIntensity instead.
enum DiamondColorGrade {
  D
  E
  F
  G
  H
  I
  J
  K
  L
  M
}

// I1 added per the owner's spec (the original list stopped at SI2).
enum DiamondClarityGrade {
  FL
  IF
  VVS1
  VVS2
  VS1
  VS2
  SI1
  SI2
  I1
}

// HRD added per the owner's spec. "No Certificate" is represented by
// leaving ProductDiamondOption.certification null — no separate enum value
// needed for that, since the field was already optional.
enum DiamondCertification {
  GIA
  IGI
  HRD
  OTHER
}

enum DiamondCutGrade {
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
}

enum DiamondFluorescence {
  NONE
  FAINT
  MEDIUM
  STRONG
  VERY_STRONG
}

// Only meaningful when diamondType = FANCY_COLOR.
enum FancyColor {
  BROWN_CHAMPAGNE
  YELLOW
  ORANGE
  PINK
  GREEN
  BLUE
  RED
}

enum FancyIntensity {
  LIGHT
  FANCY
  INTENSE
  VIVID
  DEEP
  DARK
}

// A specific diamond configuration a customer can choose for this product.
// Only created for products with hasDiamond = true. Multiple rows let a
// product offer e.g. both a 0.3ct and 0.5ct version of the same setting.
model ProductDiamondOption {
  id            String                @id @default(cuid())
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  diamondType   DiamondType
  shape         DiamondShape
  caratWeight   Decimal               @db.Decimal(6, 3)
  colorGrade    DiamondColorGrade?
  clarityGrade  DiamondClarityGrade?
  certification DiamondCertification?
  quantity      Int                   @default(1)
  isDefault     Boolean               @default(false)
  sortOrder     Int                   @default(0)
  active        Boolean               @default(true)

  // Additive fields for the owner's fuller diamond spec (origin/cut/
  // fluorescence/fancy color). All optional and unused by existing rows —
  // computeConfiguredPrice() falls back to the pre-existing shape/carat
  // lookup when these are unset, so no existing product's price changes
  // just because these columns now exist.
  cutGrade       DiamondCutGrade?
  fluorescence   DiamondFluorescence?
  growthMethod   DiamondGrowthMethod? // only meaningful when diamondType = LAB_GROWN
  fancyColor     FancyColor? // only meaningful when diamondType = FANCY_COLOR
  fancyIntensity FancyIntensity? // only meaningful when diamondType = FANCY_COLOR

  // Curated display name (e.g. "קלאסי", "פרימיום") shown to the customer
  // instead of raw grade jargon like "color G, clarity VS1" — see
  // DIAMOND_QUALITY_TIERS in src/lib/pricing/constants.ts. colorGrade/
  // clarityGrade above still hold the real values used for cost lookup;
  // this is purely a friendlier label, set when the admin picks a tier
  // preset (or left null to fall back to showing the raw grades).
  qualityTierLabel String?

  @@index([productId])
}

// Manual admin-maintained diamond price-per-carat table (see AGENTS.md
// step 7/17 — no free reliable live diamond market API exists, and paid
// feeds like RapNet/IDEX require explicit owner approval before
// integrating). A ProductDiamondOption's cost is looked up here by closest
// matching band; if no entry matches, pricing is flagged incomplete rather
// than guessed.
model DiamondPriceEntry {
  id            String               @id @default(cuid())
  diamondType   DiamondType
  shape         DiamondShape
  caratMin      Decimal              @db.Decimal(6, 3)
  caratMax      Decimal              @db.Decimal(6, 3)
  colorGrade    DiamondColorGrade?
  clarityGrade  DiamondClarityGrade?
  pricePerCarat Decimal              @db.Decimal(10, 2)
  currency      String               @default("ILS")
  source        String
  sourceUrl     String?
  updatedAt     DateTime             @updatedAt
  createdAt     DateTime             @default(now())

  @@index([diamondType, shape])
}

// The 10 wholesale base-cost buckets from the owner's diamond pricing spec
// (2026-09-26) — explicitly given as approximate ~1ct reference RANGES, not
// live supplier prices or fixed retail prices (owner's own words). This is
// the single editable source of truth for that category-level baseline;
// nothing in the codebase hardcodes these numbers. Used as a fallback for
// diamond types DiamondPriceEntry doesn't cover (brown/champagne, fancy
// colors) — a plain white NATURAL/LAB_GROWN diamond still prefers the more
// specific shape+carat-band DiamondPriceEntry lookup when a band matches.
enum DiamondCostCategory {
  LAB_GROWN
  NATURAL_BROWN_CHAMPAGNE
  NATURAL_WHITE_COMMERCIAL
  NATURAL_WHITE_GH_VS2
  NATURAL_WHITE_DF_VS_VVS
  FANCY_YELLOW
  FANCY_ORANGE
  FANCY_PINK
  FANCY_GREEN
  FANCY_BLUE
  FANCY_RED
}

model DiamondBaseCostRange {
  category        DiamondCostCategory @id
  minCostPerCarat Decimal             @db.Decimal(12, 2)
  maxCostPerCarat Decimal             @db.Decimal(12, 2)
  currency        String              @default("USD")
  note            String?
  source          String
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())
}

// Current reference price for one pure metal (per gram, 24K-gold-equivalent
// basis for gold; per gram fine silver/platinum for the others), refreshed
// by src/server/services/market-prices.ts. isManual marks a row an admin
// entered by hand (silver/platinum currently have no live free feed wired
// up) rather than one fetched automatically, so the admin panel can show
// which prices are live vs manually maintained.
model MetalPrice {
  metalType    MetalType @id
  pricePerGram Decimal   @db.Decimal(10, 2)
  currency     String    @default("ILS")
  source       String
  sourceUrl    String?
  isManual     Boolean   @default(false)
  fetchedAt    DateTime  @default(now())
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductRelation {
  id        String  @id @default(cuid())
  productId String
  relatedId String
  product   Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related   Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id])
  sortOrder Int        @default(0)
  altText   String?

  @@index([productId])
}

// Variant attributes stored as a JSON map, e.g. { "color": "Gold", "size": "M", "material": "Silver" }
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?     @unique
  attributes Json
  price      Decimal     @db.Decimal(10, 2)
  salePrice  Decimal?    @db.Decimal(10, 2)
  inventory  Int         @default(0)
  imageId    String?
  image      MediaAsset? @relation(fields: [imageId], references: [id])
  isDefault  Boolean     @default(false)

  orderItems OrderItem[]

  @@index([productId])
}

// ---------- Media / CMS ----------

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  filename  String
  // LocalizedText JSON ({ he, en?, ru? }), same shape as Product.name etc. —
  // see src/lib/i18n-content.ts. Existing rows hold a plain string from
  // before this field was localized; callers must treat a bare string value
  // as Hebrew-only (see the migration script that normalized old rows).
  altText   Json?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  categories  Category[]
  productImgs ProductImage[]
  variants    ProductVariant[]
}

model ContentBlock {
  // Editable homepage / site sections. `key` examples:
  // "homepage.hero", "homepage.new_collection", "homepage.testimonials",
  // "footer.contact", "announcement_bar"
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Page {
  // Static pages: about-us, contact-us, privacy-policy, terms, shipping-policy, returns-policy, affiliate-terms
  id             String   @id @default(cuid())
  slug           String   @unique
  title          Json
  body           Json
  seoTitle       Json?
  seoDescription Json?
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A customer's "notify me when this gets cheaper" request. priceAtSignup
// captures the displayed price (salePrice ?? basePrice) at the moment they
// subscribed — a later admin price edit only fires a notification if the
// new price is strictly below this, never on an increase or on a price
// that was already lower before they signed up. Deleted once it fires, so
// re-subscribing after a notification starts a fresh baseline.
model PriceDropSubscription {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email         String
  priceAtSignup Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  @@unique([productId, email])
}

model Setting {
  key   String @id
  value Json
}

// ---------- Orders / Coupons ----------

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  userId              String?
  user                User?         @relation(fields: [userId], references: [id])
  email               String
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       String?
  paymentInstructions String?
  subtotal            Decimal       @db.Decimal(10, 2)
  discountTotal       Decimal       @default(0) @db.Decimal(10, 2)
  shippingTotal       Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal            Decimal       @default(0) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  couponId            String?
  coupon              Coupon?       @relation(fields: [couponId], references: [id])
  affiliateId         String?
  affiliate           Affiliate?    @relation(fields: [affiliateId], references: [id])
  shippingAddress     Json
  billingAddress      Json
  trackingNumber      String?
  items               OrderItem[]
  commission          Commission?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
  @@index([affiliateId])
  @@index([paymentStatus])
  @@index([email])
  @@index([userId])
  @@index([couponId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  nameSnapshot String
  unitPrice    Decimal         @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal         @db.Decimal(10, 2)

  @@index([orderId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  affiliateId   String?
  affiliate     Affiliate?   @relation(fields: [affiliateId], references: [id])
  usageLimit    Int?
  usageCount    Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
}

// ---------- Shipping ----------

enum ShippingMethodType {
  FREE
  FLAT_RATE
  BY_COUNTRY
  BY_ORDER_VALUE
}

model ShippingRule {
  id            String             @id @default(cuid())
  name          String
  type          ShippingMethodType
  country       String?
  minOrderValue Decimal?           @db.Decimal(10, 2)
  price         Decimal            @default(0) @db.Decimal(10, 2)
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
}

// ---------- Affiliates ----------

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AffiliateTierName {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

model Affiliate {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  code               String            @unique // e.g. LD123
  status             AffiliateStatus   @default(PENDING)
  tier               AffiliateTierName @default(BRONZE)
  commissionOverride Decimal?          @db.Decimal(5, 2) // percentage override
  fixedCommission    Decimal?          @db.Decimal(10, 2) // fixed amount override
  socialInstagram    String?
  socialTiktok       String?
  socialFacebook     String?
  socialYoutube      String?
  website            String?
  promotionMethod    String?
  paymentDetails     Json?
  appliedAt          DateTime          @default(now())
  approvedAt         DateTime?

  clicks      AffiliateClick[]
  orders      Order[]
  commissions Commission[]
  coupons     Coupon[]
  payouts     Payout[]

  @@index([status])
}

model AffiliateTierRule {
  id                String            @id @default(cuid())
  tier              AffiliateTierName @unique
  minSales          Int               @default(0)
  commissionPercent Decimal           @db.Decimal(5, 2)
  bonus             Decimal?          @db.Decimal(10, 2)
  isActive          Boolean           @default(true)
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  landingPage String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  sessionId   String
  ip          String?
  createdAt   DateTime  @default(now())

  // The dedup lookup in trackReferral filters on both columns together
  // (affiliateId + sessionId) — a compound index serves that exact-match
  // query directly instead of relying on two independent single-column
  // indexes. Kept the single-column affiliateId index too since admin
  // analytics/click-count queries filter by affiliateId alone.
  @@index([affiliateId])
  @@index([affiliateId, sessionId])
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Commission {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  orderId     String           @unique
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Decimal          @db.Decimal(10, 2)
  status      CommissionStatus @default(PENDING)
  payoutId    String?
  payout      Payout?          @relation(fields: [payoutId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([affiliateId])
  @@index([status])
  @@index([payoutId])
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  commissions Commission[]
  createdAt   DateTime     @default(now())
}
