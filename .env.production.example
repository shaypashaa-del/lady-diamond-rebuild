# Template for the Hostinger Node.js App environment variables.
# Copy these keys into hPanel → Websites → your site → Node.js → Environment
# variables. Real values live only in Hostinger's env-var UI and in the local
# (gitignored) .env file — never commit actual secrets here.

# Supabase Postgres connection string (Project Settings → Database →
# Connection string → URI). Use the "connection pooling" URI (port 6543) for
# the app's runtime DATABASE_URL, since shared hosting keeps a Node process
# alive with a limited connection pool.
DATABASE_URL=

# Random 32+ byte secret used to sign session cookies. Generate with:
# openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Port Hostinger's Node.js App assigns this app (it sets PORT itself; only
# needed here if hPanel requires an explicit value).
PORT=3000

# Shared secret configured on the GitHub webhook (Settings → Webhooks) that
# POSTs to /api/deploy on every push. Generate with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=
