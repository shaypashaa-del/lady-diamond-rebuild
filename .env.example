# Postgres connection string
DATABASE_URL="postgres://postgres:postgres@localhost:5432/lady_diamond?sslmode=disable"

# Signs session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Used in metadata/sitemap/structured data. Defaults to https://ladydiamondjewels.com if unset.
NEXT_PUBLIC_SITE_URL=""

# Optional: override the bootstrap Super Admin created by prisma/seed.ts
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Only needed to run scripts/import-woocommerce.ts against the live WordPress site.
# From WooCommerce > Settings > Advanced > REST API (read-only key is enough).
WC_STORE_URL=""
WC_CONSUMER_KEY=""
WC_CONSUMER_SECRET=""

# PayPal Checkout. Defaults to PayPal's public sandbox test client ID ("sb")
# so the button works out of the box for testing — no real charges happen.
# To go live: create a Business account at developer.paypal.com, copy the
# Client ID + Secret from Apps & Credentials, and set both here (also switch
# NEXT_PUBLIC_PAYPAL_CLIENT_ID). Without PAYPAL_CLIENT_SECRET, order capture
# is trusted client-side (fine for sandbox, never for production).
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"
PAYPAL_CLIENT_SECRET=""
