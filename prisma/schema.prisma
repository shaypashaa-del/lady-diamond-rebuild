// Lady Diamond Jewels — rebuild schema (Phase 1)
// learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth / Users ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  STORE_MANAGER
  AFFILIATE
  CUSTOMER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role     @default(CUSTOMER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses  Address[]
  orders     Order[]
  affiliate  Affiliate?
  notes      CustomerNote[]
  resetTokens PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  country    String
  city       String
  street     String
  apartment  String?
  zip        String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Catalog ----------

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Translatable text fields are stored as JSON objects, e.g. { "he": "...", "en": "...", "ru": "..." }.
// Hebrew ("he") is the required/default key; "en" and "ru" may be partial and fall back to "he"
// at render time (see src/lib/i18n-content.ts).

model Category {
  id              String     @id @default(cuid())
  name            Json
  slug            String     @unique
  description     Json?
  imageId         String?
  image           MediaAsset? @relation(fields: [imageId], references: [id])
  parentId        String?
  parent          Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToParent")
  sortOrder       Int        @default(0)
  seoTitle        Json?
  seoDescription  Json?
  products        ProductCategory[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([parentId])
}

model Tag {
  id       String            @id @default(cuid())
  name     Json
  slug     String            @unique
  products ProductTag[]
}

model Product {
  id              String   @id @default(cuid())
  name            Json
  slug            String   @unique
  description     Json?
  shortDescription Json?
  basePrice       Decimal  @db.Decimal(10, 2)
  salePrice       Decimal? @db.Decimal(10, 2)
  sku             String?  @unique
  inventory       Int      @default(0)
  trackInventory  Boolean  @default(true)
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean  @default(false)
  seoTitle        Json?
  seoDescription  Json?
  weightGrams     Int?

  categories      ProductCategory[]
  tags            ProductTag[]
  images          ProductImage[]
  variants        ProductVariant[]
  relatedTo       ProductRelation[] @relation("RelatedFrom")
  relatedFrom     ProductRelation[] @relation("RelatedTo")
  orderItems      OrderItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([isFeatured])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductRelation {
  id           String  @id @default(cuid())
  productId    String
  relatedId    String
  product      Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related      Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id])
  sortOrder Int      @default(0)
  altText   String?

  @@index([productId])
}

// Variant attributes stored as a JSON map, e.g. { "color": "Gold", "size": "M", "material": "Silver" }
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?  @unique
  attributes Json
  price      Decimal  @db.Decimal(10, 2)
  salePrice  Decimal? @db.Decimal(10, 2)
  inventory  Int      @default(0)
  imageId    String?
  image      MediaAsset? @relation(fields: [imageId], references: [id])
  isDefault  Boolean  @default(false)

  orderItems OrderItem[]

  @@index([productId])
}

// ---------- Media / CMS ----------

model MediaAsset {
  id          String   @id @default(cuid())
  url         String
  filename    String
  altText     String?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  categories  Category[]
  productImgs ProductImage[]
  variants    ProductVariant[]
}

model ContentBlock {
  // Editable homepage / site sections. `key` examples:
  // "homepage.hero", "homepage.new_collection", "homepage.testimonials",
  // "footer.contact", "announcement_bar"
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Page {
  // Static/legal pages: privacy-policy, terms, shipping-policy, returns-policy, affiliate-terms
  id        String   @id @default(cuid())
  slug      String   @unique
  title     Json
  body      Json
  seoTitle  Json?
  seoDescription Json?
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value Json
}

// ---------- Orders / Coupons ----------

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  email          String
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  String?
  paymentInstructions String?
  subtotal       Decimal       @db.Decimal(10, 2)
  discountTotal  Decimal       @db.Decimal(10, 2) @default(0)
  shippingTotal  Decimal       @db.Decimal(10, 2) @default(0)
  taxTotal       Decimal       @db.Decimal(10, 2) @default(0)
  total          Decimal       @db.Decimal(10, 2)
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  affiliateId    String?
  affiliate      Affiliate?    @relation(fields: [affiliateId], references: [id])
  shippingAddress Json
  billingAddress  Json
  trackingNumber String?
  items          OrderItem[]
  commission     Commission?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([affiliateId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  nameSnapshot String
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int
  lineTotal  Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  affiliateId   String?
  affiliate     Affiliate?   @relation(fields: [affiliateId], references: [id])
  usageLimit    Int?
  usageCount    Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
}

// ---------- Shipping ----------

enum ShippingMethodType {
  FREE
  FLAT_RATE
  BY_COUNTRY
  BY_ORDER_VALUE
}

model ShippingRule {
  id         String             @id @default(cuid())
  name       String
  type       ShippingMethodType
  country    String?
  minOrderValue Decimal?        @db.Decimal(10, 2)
  price      Decimal            @db.Decimal(10, 2) @default(0)
  isActive   Boolean            @default(true)
  sortOrder  Int                @default(0)
}

// ---------- Affiliates ----------

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AffiliateTierName {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

model Affiliate {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String          @unique // e.g. LD123
  status          AffiliateStatus @default(PENDING)
  tier            AffiliateTierName @default(BRONZE)
  commissionOverride Decimal?     @db.Decimal(5, 2) // percentage override
  fixedCommission Decimal?        @db.Decimal(10, 2) // fixed amount override
  socialInstagram String?
  socialTiktok    String?
  socialFacebook  String?
  socialYoutube   String?
  website         String?
  promotionMethod String?
  paymentDetails  Json?
  appliedAt       DateTime        @default(now())
  approvedAt      DateTime?

  clicks          AffiliateClick[]
  orders          Order[]
  commissions     Commission[]
  coupons         Coupon[]
  payouts         Payout[]

  @@index([status])
}

model AffiliateTierRule {
  id          String            @id @default(cuid())
  tier        AffiliateTierName @unique
  minSales    Int               @default(0)
  commissionPercent Decimal     @db.Decimal(5, 2)
  bonus       Decimal?          @db.Decimal(10, 2)
  isActive    Boolean           @default(true)
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  landingPage String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  sessionId   String
  ip          String?
  createdAt   DateTime @default(now())

  @@index([affiliateId])
  @@index([sessionId])
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Commission {
  id          String            @id @default(cuid())
  affiliateId String
  affiliate   Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  orderId     String            @unique
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Decimal           @db.Decimal(10, 2)
  status      CommissionStatus  @default(PENDING)
  payoutId    String?
  payout      Payout?           @relation(fields: [payoutId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([affiliateId])
  @@index([status])
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  commissions Commission[]
  createdAt   DateTime     @default(now())
}
